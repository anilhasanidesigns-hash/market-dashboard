# ==============================================================================
# Market Dashboard - Environment Configuration
# ==============================================================================
# Copy this file to ".env" and fill in values if you want to use an optional
# paid/keyed data provider. The app works OUT OF THE BOX with no keys at all,
# because the default provider (Yahoo Finance's public quote/chart endpoints)
# does not require authentication.
#
# The keys below are OPTIONAL fallbacks. If they are not set, the app simply
# will not use that provider, and will show "DATA UNAVAILABLE" for anything
# that genuinely cannot be fetched. The app will NEVER invent data to fill
# a missing key.
# ==============================================================================

# Port the local Express proxy server listens on
PORT=3000

# --- OPTIONAL: Twelve Data (https://twelvedata.com) --------------------------
# Used only as an optional secondary/fallback provider for equities & FX if
# you choose to wire it up in server/providers/twelveData.js.
# Free tier: 8 requests/min, 800 requests/day (subject to change by vendor).
# Get a free key at: https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# --- OPTIONAL: metals.dev / metals-api (https://metals-api.com) --------------
# Used only as an optional secondary/fallback provider for Gold/Silver spot
# prices in INR if you want spot metal prices instead of COMEX futures.
# Free tier is very limited (typically 50 requests/month).
# Get a free key at: https://metals-api.com
METALS_API_KEY=

# ==============================================================================
# WHICH KEY DOES WHAT
# ==============================================================================
# TWELVE_DATA_API_KEY  -> optional fallback for stocks/indices/FX quotes
# METALS_API_KEY       -> optional fallback for Gold/Silver spot price in INR
#
# DEFAULT (no keys needed): all data is fetched server-side from Yahoo
# Finance's public, unauthenticated quote & chart endpoints. See
# server/providers/yahooFinance.js and README.md ("Data Providers") for
# exactly which symbol maps to which market.
# ==============================================================================
